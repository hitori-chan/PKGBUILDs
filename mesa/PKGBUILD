    wayland
    xcb-util-keysyms
    zlib
    zstd
  )
  optdepends=("vulkan-mesa-layers: additional vulkan layers")
  provides=(vulkan-driver)

  mv vkasahi/* "$pkgdir"

  install -Dm644 $_srcname/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

