# Contributor: Mark Wagie <mark dot wagie at proton dot me>
_pkgname=MangoHud
_commit=9df8f5ff92f490b76a087c204150f8639994cb49
pkgname=mangohud
pkgver=0.8.4.r260
pkgrel=1
pkgdesc="A Vulkan overlay layer for monitoring FPS, temperatures, CPU/GPU load and more."
arch=('aarch64')
url="https://github.com/hitori-chan/MangoHud"
license=('MIT' 'GPL-2.0-only')
makedepends=('appstream' 'cmocka' 'dbus' 'git' 'glslang' 'libxnvctrl' 'libxrandr' 'meson' 'python-mako' 'vulkan-headers' 'wayland-protocols')
depends=('dbus' 'fmt' 'glfw' 'hicolor-icon-theme' 'libdrm' 'libglvnd' 'libx11' 'libxkbcommon' 'mesa' 'python' 'python-matplotlib' 'python-numpy' 'systemd-libs' 'vulkan-icd-loader' 'wayland' 'yaml-cpp')
optdepends=('gamescope: Use MangoApp as an overlay within gamescope'
            'libxnvctrl: NVIDIA GPU stats by XNVCtrl')
replaces=("$pkgname-common" "$pkgname-common-wayland" "$pkgname-common-x11" "mangoapp" "$pkgname-x11" "$pkgname-wayland")
conflicts=("$pkgname-common" "$pkgname-common-wayland" "$pkgname-common-x11" "mangoapp" "$pkgname-x11" "$pkgname-wayland")
source=("$_pkgname::git+$url.git#commit=$_commit")
b2sums=('SKIP')

build() {
    arch-meson "$_pkgname" build \
        -Dmangoapp=true \
        -Dmangohudctl=true \
        --wrap-mode=default

    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"

    install -Dm 0644 "$srcdir/$_pkgname/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
