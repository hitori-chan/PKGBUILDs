pkgname=asahi-va-driver
_tree=asahi-va-driver
_commit=c263d2c8b28275332e1869ef9d41810d8116c196
pkgver=2.0.r10
pkgrel=1
pkgdesc='VA-API driver for V4L2 stateless decoders, for the Apple Video Decoder'
arch=('aarch64')
url='https://github.com/hitori-chan/asahi-va-driver'
depends=('libva' 'libdrm')
makedepends=('meson' 'linux-api-headers')
license=('GPL-3.0-or-later')
provides=('libva-driver')
conflicts=('libva-v4l2-request' 'libva-v4l2_request' 'libva-v4l2_request-avd')
replaces=('libva-v4l2-request')
source=(
  "asahi-va-driver-${_commit}.tar.gz::https://github.com/hitori-chan/asahi-va-driver/archive/${_commit}.tar.gz"
)
sha256sums=('9dc342c0f4c7e160ec7cf071871ce5b03720440129d0a99b9d9a57957fae87ed')

build() {
  arch-meson "asahi-va-driver-${_commit}" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
