--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2428,7 +2428,11 @@
 {
 #ifdef HAVE_SCHED_YIELD
 #ifdef RUSAGE_THREAD
+    /* yields in a row that found nothing else to run, each within 100 us of the last */
+    static __thread unsigned int idle_run;
+    static __thread ULONGLONG idle_last;
     struct rusage u1, u2;
+    ULONGLONG now;
     int ret;
 
     ret = getrusage( RUSAGE_THREAD, &u1 );
@@ -2436,7 +2440,22 @@
     sched_yield();
 #ifdef RUSAGE_THREAD
     if (!ret) ret = getrusage( RUSAGE_THREAD, &u2 );
-    if (!ret && u1.ru_nvcsw == u2.ru_nvcsw && u1.ru_nivcsw == u2.ru_nivcsw) return STATUS_NO_YIELD_PERFORMED;
+    if (!ret && u1.ru_nvcsw == u2.ru_nvcsw && u1.ru_nivcsw == u2.ru_nivcsw)
+    {
+        /* A spin on SwitchToThread keeps its CPU busy at its top clock for nothing once nothing else wants
+         * it: past a short spin, give the CPU up for a moment, as an adaptive lock blocks after spinning */
+        now = monotonic_counter();
+        idle_run = now - idle_last < 1000 ? idle_run + 1 : 0;
+        idle_last = now;
+        if (idle_run < 64) return STATUS_NO_YIELD_PERFORMED;
+        {
+            static const struct timespec t = { 0, 1000 };
+
+            nanosleep( &t, NULL );
+            idle_last = monotonic_counter();
+        }
+    }
+    else idle_run = 0;
 #endif
     return STATUS_SUCCESS;
 #else
