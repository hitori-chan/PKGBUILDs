+/* A kernel with per-process page sizes (arm64's CONFIG_ARM64_PER_PROCESS_PAGE_SIZE) gives a process 4K pages, the
+ * granularity Windows code expects, when its personality has ADDR_PAGE_SIZE_4KB at exec. Ask for them before the
+ * loader's exec; the processes Wine starts inherit the flag. On a kernel without the feature the flag does nothing,
+ * and the next start sees it set. WINE_P3S=0 turns this off. */
+static BOOL p3s_ask_4k_pages(void)
+{
+#if defined(__linux__) && defined(__aarch64__)
+    static const unsigned int ADDR_PAGE_SIZE_4KB = 0x40000000;
+    const char *opt = getenv( "WINE_P3S" );
+    int pers;
+
+    if (sysconf( _SC_PAGESIZE ) == 4096 || (opt && !strcmp( opt, "0" ))) return FALSE;
+    if ((pers = personality( 0xffffffff )) == -1 || (pers & ADDR_PAGE_SIZE_4KB)) return FALSE;
+    return personality( pers | ADDR_PAGE_SIZE_4KB ) != -1;
+#else
+    return FALSE;
+#endif
+}
