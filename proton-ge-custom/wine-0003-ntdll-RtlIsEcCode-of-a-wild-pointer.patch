diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 712d7f4..083944d 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -1412,6 +1412,9 @@ BOOLEAN WINAPI RtlIsEcCode( ULONG_PTR ptr )
 {
     const UINT64 *map = (const UINT64 *)NtCurrentTeb()->Peb->EcCodeBitMap;
     ULONG_PTR page = ptr / page_size;
+
+    /* the map covers 47 bits: a wild pointer here, in the exception dispatcher, must not fault */
+    if (ptr >> 47) return FALSE;
     return (map[page / 64] >> (page & 63)) & 1;
 }
 
