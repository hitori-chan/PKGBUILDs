pkgname=proton-ge-custom
pkgver=11.12
pkgrel=2
pkgdesc='GE-Proton on a 16K kernel with per-process page sizes (P3S): its aarch64 release, Wine as a 4K process, our fixes'
arch=('aarch64')
url='https://github.com/GloriousEggroll/proton-ge-custom'
license=('BSD-3-Clause' 'LGPL-2.1-or-later' 'MIT')
depends=('python')
makedepends=('autoconf' 'bison' 'clang' 'cmake' 'flex' 'git' 'libxkbcommon' 'lld' 'llvm' 'ninja' 'perl' 'wayland')
options=('!debug' '!lto' '!strip')
source=("https://github.com/GloriousEggroll/proton-ge-custom/releases/download/$_ge/$_ge-aarch64.tar.gz"
