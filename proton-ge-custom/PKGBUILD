        "wine-staging::git+https://github.com/wine-staging/wine-staging.git#commit=$_staging"
        "FEX::git+https://github.com/FEX-Emu/FEX.git#commit=$_fex"
        "https://github.com/mstorsjo/llvm-mingw/releases/download/20261020/$_mingw.tar.xz"
        'wine-0003-ntdll-RtlIsEcCode-of-a-wild-pointer.patch'
        'wine-0004-ntdll-an-alert-a-WoW64-thread-s-host-side-took.patch'
        'wine-0005-ntdll-NtYieldExecution-sleeps.patch'
        'wine-0006-ntdll-4K-pages-on-a-kernel-with-per-process-page-sizes.patch'
        'fex-0004-ARM64EC-no-FPCR-write-at-exit-when-nothing-changes.patch'
        'proton-0001-FEX-full-x87-for-installers-in-every-game.patch')
sha256sums=('cbf85e13a6a500cb6747881620b061faccf3c93e05e2102c6b5e992d5aa44c78'
