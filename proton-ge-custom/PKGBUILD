prepare() {
    ln -sfn "proton-ge-custom-$_ge/patches" patches
    ln -sfn "proton-ge-custom-$_ge/wineopenxr" wineopenxr
    { sed -n 1,14p patches/protonprep-valve-staging.sh; sed -n 122,691p patches/protonprep-valve-staging.sh; } > wine-prep.sh
    bash wine-prep.sh

    cd wine
    find . -name '*.orig' -delete
    XDG_CACHE_HOME="$srcdir/cache" dlls/winevulkan/make_vulkan -x vk.xml -X video.xml
    tools/make_specfiles
    for p in "$srcdir"/wine-*.patch; do
        patch -Np1 -i "$p"
    done

    cd ../FEX
    git submodule update --init --recursive --depth 1
    for p in "$srcdir"/fex-*.patch; do
        patch -Np1 -i "$p"
    done
}

build() {
    unset CFLAGS CXXFLAGS LDFLAGS
    mkdir -p wine-build
    (
        cd wine-build
        ../wine/configure --enable-archs=arm64ec,aarch64,i386 --with-mingw=clang --disable-tests --with-wayland
        make dlls/ntdll/all
    )

    export PATH="$srcdir/$_mingw/bin:$PATH"
    local a="-DCMAKE_BUILD_TYPE=Release -DENABLE_FEXCORE_PROFILER=True -DENABLE_LTO=False -DBUILD_TESTING=False"
    a+=" -DENABLE_JEMALLOC_GLIBC_ALLOC=False -DTUNE_CPU=none -DTUNE_ARCH=armv8.5-a -DCMAKE_TOOLCHAIN_FILE=$srcdir/FEX/Data/CMake/toolchain_mingw.cmake"
    a+=" -DOVERRIDE_VERSION=$(git -C FEX describe --abbrev=7) -DOVERRIDE_HASH=$(git -C FEX rev-parse --short=7 HEAD)"
    cmake -S FEX -B fex-wow64 -G Ninja -DMINGW_TRIPLE=aarch64-w64-mingw32 $a
    ninja -C fex-wow64 wow64fex
    cmake -S FEX -B fex-ec -G Ninja -DMINGW_TRIPLE=arm64ec-w64-mingw32 $a
    ninja -C fex-ec arm64ecfex
}

package() {
    local d="$pkgdir/usr/share/steam/compatibilitytools.d/$_ge-p3s"
    install -d "${d%/*}"
    cp -a "$_ge-aarch64" "$d"
    sed -i "s/$_ge-aarch64/$_ge-p3s/g" "$d/compatibilitytool.vdf"
    patch -d "$d" -Np1 -i "$srcdir/proton-0001-FEX-full-x87-for-installers-in-every-game.patch"

    local w="$d/files/lib/wine"
    install -m 755 wine-build/dlls/ntdll/ntdll.so "$w/aarch64-unix/ntdll.so"
    install -m 644 wine-build/dlls/ntdll/aarch64-windows/ntdll.dll "$w/aarch64-windows/ntdll.dll"
    install -m 644 wine-build/dlls/ntdll/i386-windows/ntdll.dll "$w/i386-windows/ntdll.dll"
    install -m 644 fex-wow64/Bin/libwow64fex.dll fex-ec/Bin/libarm64ecfex.dll "$w/aarch64-windows/"

    install -Dm 644 "$_ge-aarch64/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
