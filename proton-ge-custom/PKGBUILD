_ge=GE-Proton11-14
_tag=$_ge-m3.1
_wine=a47c73f52fd7b2efafc1c560710f3a5099ae51e0
_fex=490bb02f6e6b7b50f17049e5bb254bd5a6a2b779
_staging=6cc805ea57132eeaf44764e9213823c9b8d0d300
_mingw=llvm-mingw-20261020-ucrt-ubuntu-22.04-aarch64
pkgname=proton-ge-custom
pkgver=11.14
pkgrel=1
pkgdesc='GE-Proton on a 16K kernel with per-process page sizes (P3S): its aarch64 release, Wine as a 4K process, our fixes'
arch=('aarch64')
url='https://github.com/hitori-chan/proton-ge-custom'
license=('BSD-3-Clause' 'LGPL-2.1-or-later' 'MIT')
depends=('python')
makedepends=('autoconf' 'bison' 'clang' 'cmake' 'flex' 'git' 'libxkbcommon' 'lld' 'llvm' 'ninja' 'perl' 'wayland')
options=('!debug' '!lto' '!strip')
source=("https://github.com/GloriousEggroll/proton-ge-custom/releases/download/$_ge/$_ge-aarch64.tar.gz"
        "proton-ge-custom-$_tag.tar.gz::https://github.com/hitori-chan/proton-ge-custom/archive/refs/tags/$_tag.tar.gz"
        "wine::git+https://github.com/ValveSoftware/wine.git#commit=$_wine"
        "wine-staging::git+https://github.com/wine-staging/wine-staging.git#commit=$_staging"
        "FEX::git+https://github.com/FEX-Emu/FEX.git#commit=$_fex"
        "https://github.com/mstorsjo/llvm-mingw/releases/download/20261020/$_mingw.tar.xz")
sha256sums=('f6353f4417bd8c1148d7db18bc383d8e2c59c403e367425fd8b9daaaecc2fad8'
            '7f075a80d9184afc98b69d545a481e62ab845500ba078747a73f525e297d1b89'
            'SKIP'
            'SKIP'
            'SKIP'
            'ca16bb0f4f485876496fa46ad8d353c525eba57d0cf9e9e49ec1738fe4810151')

prepare() {
    ln -sfn "proton-ge-custom-$_tag/patches" patches
    ln -sfn "proton-ge-custom-$_tag/wineopenxr" wineopenxr
    # GE's patch functions, its Wine section and the fork's FEX section, by their markers
    local pp=patches/protonprep-valve-staging.sh
    { sed -n '1,/^### (1) PREP SECTION ###$/p' $pp; sed -n '/^### (2) WINE PATCHING ###$/,/^### END FEX PATCHING ###$/p' $pp; } > prep.sh
    grep -q '^### END FEX PATCHING ###$' prep.sh || { echo "prep.sh: no FEX section: not the m3 fork's script"; return 1; }
    bash prep.sh
    # GE's apply_patch goes on past a failed patch
    if find wine FEX -name '*.rej' | grep -q .; then
        echo "a patch failed:"; find wine FEX -name '*.rej'; return 1
    fi

    cd wine
    find . -name '*.orig' -delete
    XDG_CACHE_HOME="$srcdir/cache" dlls/winevulkan/make_vulkan -x vk.xml -X video.xml
    tools/make_specfiles

    cd ../FEX
    git submodule update --init --recursive --depth 1
}

build() {
    unset CFLAGS CXXFLAGS LDFLAGS
    mkdir -p wine-build
    (
        cd wine-build
        ../wine/configure --enable-archs=arm64ec,aarch64,i386 --with-mingw=clang --disable-tests --with-wayland
        make dlls/ntdll/all
    )

    # FEX's Unix side from the same commit as its DLLs: they share one call table, and the release's .so files
    # predate the calls a newer FEX adds (2611's CheckSupportsTPIDRRO_CPU), which then land past its end
    cmake -S FEX/Source/Windows/UnixLib -B fex-unix -G Ninja -DCMAKE_BUILD_TYPE=Release
    ninja -C fex-unix

    export PATH="$srcdir/$_mingw/bin:$PATH"
    local a="-DCMAKE_BUILD_TYPE=Release -DENABLE_FEXCORE_PROFILER=True -DENABLE_LTO=False -DBUILD_TESTING=False"
    a+=" -DENABLE_JEMALLOC_GLIBC_ALLOC=False -DTUNE_CPU=none -DTUNE_ARCH=armv8.5-a -DCMAKE_TOOLCHAIN_FILE=$srcdir/FEX/Data/CMake/toolchain_mingw.cmake"
    a+=" -DOVERRIDE_VERSION=$(git -C FEX describe --abbrev=7) -DOVERRIDE_HASH=$(git -C FEX rev-parse --short=7 HEAD)"
    cmake -S FEX -B fex-wow64 -G Ninja -DMINGW_TRIPLE=aarch64-w64-mingw32 $a
    ninja -C fex-wow64 wow64fex
    cmake -S FEX -B fex-ec -G Ninja -DMINGW_TRIPLE=arm64ec-w64-mingw32 $a
    ninja -C fex-ec arm64ecfex
}

package() {
    local d="$pkgdir/usr/share/steam/compatibilitytools.d/$_ge-p3s"
    install -d "${d%/*}"
    cp -a "$_ge-aarch64" "$d"
    sed -i "s/$_ge-aarch64/$_ge-p3s/g" "$d/compatibilitytool.vdf"
    # GE's release ships its source's proton unchanged (11-12 compared): the fork's adds the installers' full x87
    install -m 755 "proton-ge-custom-$_tag/proton" "$d/proton"

    local w="$d/files/lib/wine"
    install -m 755 wine-build/dlls/ntdll/ntdll.so "$w/aarch64-unix/ntdll.so"
    install -m 644 wine-build/dlls/ntdll/aarch64-windows/ntdll.dll "$w/aarch64-windows/ntdll.dll"
    install -m 644 wine-build/dlls/ntdll/i386-windows/ntdll.dll "$w/i386-windows/ntdll.dll"
    install -m 644 fex-wow64/Bin/libwow64fex.dll fex-ec/Bin/libarm64ecfex.dll "$w/aarch64-windows/"
    install -m 755 fex-unix/libwow64fex.so fex-unix/libarm64ecfex.so "$w/aarch64-unix/"

    install -Dm 644 "$_ge-aarch64/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
