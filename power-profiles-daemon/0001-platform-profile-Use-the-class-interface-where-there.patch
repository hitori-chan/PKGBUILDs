From 830e8298763b0c6fe6a9a05a478e066f0fc45789 Mon Sep 17 00:00:00 2001
From: hitori-chan <hitori1403@gmail.com>
Date: Tue, 24 Nov 2026 11:13:39 +0700
Subject: [PATCH 1/4] platform-profile: Use the class interface where there is
 no ACPI

A machine without ACPI has no /sys/firmware/acpi/platform_profile, the
legacy file the kernel builds over the handlers of the platform-profile
class, only the class devices: /sys/class/platform-profile/*/{profile,
choices} (Documentation/ABI/testing/sysfs-class-platform-profile). Where the
legacy file is absent, use those devices as it would: offer the choices they
share, write the profile to each, read their common profile ("custom" when
they differ), and follow each one's changes.

The driver keeps its name, so a saved configuration still applies.
---
 src/ppd-driver-platform-profile.c | 175 +++++++++++++++++++++---------
 tests/integration_test.py         |  69 ++++++++++++
 2 files changed, 194 insertions(+), 50 deletions(-)

diff --git a/src/ppd-driver-platform-profile.c b/src/ppd-driver-platform-profile.c
index 28fc335..d9bf10b 100644
--- a/src/ppd-driver-platform-profile.c
+++ b/src/ppd-driver-platform-profile.c
@@ -18,6 +18,10 @@
 #define LAPMODE_SYSFS_NAME "dytc_lapmode"
 #define ACPI_PLATFORM_PROFILE_PATH "/sys/firmware/acpi/platform_profile"
 #define ACPI_PLATFORM_PROFILE_CHOICES_PATH "/sys/firmware/acpi/platform_profile_choices"
+/* The class interface, the only one where there is no ACPI:
+ * https://www.kernel.org/doc/Documentation/ABI/testing/sysfs-class-platform-profile
+ */
+#define CLASS_PLATFORM_PROFILE_PATH "/sys/class/platform-profile"
 
