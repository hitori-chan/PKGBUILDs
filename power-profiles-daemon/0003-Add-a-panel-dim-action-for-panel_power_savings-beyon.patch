diff --git a/tests/integration_test.py b/tests/integration_test.py
index b563fec..848b789 100644
--- a/tests/integration_test.py
+++ b/tests/integration_test.py
@@ -1716,6 +1716,72 @@ class Tests(dbusmock.DBusTestCase):
         self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
         self.assert_sysfs_attr_eventually_is(card, amdgpu_dpm, "low")
 
+    def test_panel_dim(self):
+        """The panel dimmed on battery and in power-saver, as macOS does"""
+        panel_power_savings = "apple/panel_power_savings"
+        edp = self.testbed.add_device(
+            "drm",
+            "card2-eDP-1",
+            None,
+            ["status", "connected\n", panel_power_savings, "0"],
+            ["DEVTYPE", "drm_connector"],
+        )
+        # amdgpu's attribute is its own action's
+        amdgpu_panel_power_savings = "amdgpu/panel_power_savings"
+        amdgpu_edp = self.testbed.add_device(
+            "drm",
+            "card1-eDP-2",
+            None,
+            ["status", "connected\n", amdgpu_panel_power_savings, "0"],
+            ["DEVTYPE", "drm_connector"],
+        )
+        self.create_class_platform_profile()
+        _, upowerd_obj, _ = self.start_dbus_template(
+            "upower",
+            {"DaemonVersion": "0.99", "OnBattery": False},
+        )
+        self.start_daemon()
+
+        # on by default; none on AC in balanced
+        self.assert_action_enabled("panel_dim")
+        self.assert_sysfs_attr_eventually_is(
+            edp, panel_power_savings, "0", keep_checking=500
+        )
+
+        # on battery, whatever the profile
+        upowerd_obj.Set("org.freedesktop.UPower", "OnBattery", True)
+        self.assert_sysfs_attr_eventually_is(edp, panel_power_savings, "1")
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("performance"))
+        self.assert_sysfs_attr_eventually_is(
+            edp, panel_power_savings, "1", keep_checking=500
+        )
+
+        # on AC, in power-saver only
+        upowerd_obj.Set("org.freedesktop.UPower", "OnBattery", False)
+        self.assert_sysfs_attr_eventually_is(edp, panel_power_savings, "0")
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
+        self.assert_sysfs_attr_eventually_is(edp, panel_power_savings, "1")
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("balanced"))
+        self.assert_sysfs_attr_eventually_is(edp, panel_power_savings, "0")
+
+        self.assertEqual(
+            self.read_sysfs_attr(amdgpu_edp, amdgpu_panel_power_savings), b"0"
+        )
+
+        # turned off, it undims the panel and leaves it alone
+        if self.PP_INTERFACE != "org.freedesktop.UPower.PowerProfiles":
+            return
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
+        self.assert_sysfs_attr_eventually_is(edp, panel_power_savings, "1")
+        self.call_dbus_method(
+            "SetActionEnabled", GLib.Variant("(sb)", ("panel_dim", False))
+        )
+        self.assert_sysfs_attr_eventually_is(edp, panel_power_savings, "0")
+        upowerd_obj.Set("org.freedesktop.UPower", "OnBattery", True)
+        self.assert_sysfs_attr_eventually_is(
+            edp, panel_power_savings, "0", keep_checking=500
+        )
+
     def test_amdgpu_panel_power(self):
         """Verify AMDGPU Panel power actions"""
         amdgpu_panel_power_savings = "amdgpu/panel_power_savings"
