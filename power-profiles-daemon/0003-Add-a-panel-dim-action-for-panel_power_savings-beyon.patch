diff --git a/src/ppd-action-panel-dim.c b/src/ppd-action-panel-dim.c
new file mode 100644
index 0000000..d9cbddd
--- /dev/null
+++ b/src/ppd-action-panel-dim.c
@@ -0,0 +1,257 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ *
+ * Copyright (c) 2024 Advanced Micro Devices
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ *
+ */
+
+#define G_LOG_DOMAIN "PanelDim"
+
+#include "config.h"
+
+#include <gudev/gudev.h>
+
+#include "ppd-action-panel-dim.h"
+#include "ppd-profile.h"
+#include "ppd-utils.h"
+
+#define PANEL_POWER_SYSFS_NAME "panel_power_savings"
+#define PANEL_STATUS_SYSFS_NAME "status"
+/* amdgpu's attribute, which the amdgpu_panel_power action drives */
+#define AMDGPU_GROUP_NAME "amdgpu"
+
+/**
+ * SECTION:ppd-action-panel-dim
+ * @Short_description: The panel dimmed on battery and in power-saver
+ * @Title: Panel dim action
+ *
+ * The panel dim action writes the "panel_power_savings" attribute that a DRM
+ * driver other than amdgpu gives a panel's connector, in a group named after
+ * the driver ("apple/panel_power_savings"), with amdgpu's values: 0 for none,
+ * 1 to 4 for its power savings. It writes 1 on battery and in power-saver,
+ * else 0, as macOS dims its panel on battery and in Low Power on AC.
+ *
+ */
+
+struct _PpdActionPanelDim
+{
+  PpdAction  parent_instance;
+  PpdProfile last_profile;
+
+  GUdevClient *client;
+
+  gint target;
+  gboolean on_battery;
+};
+
+G_DEFINE_TYPE (PpdActionPanelDim, ppd_action_panel_dim, PPD_TYPE_ACTION)
+
+static GObject*
+ppd_action_panel_dim_constructor (GType                  type,
+                                  guint                  n_construct_params,
+                                  GObjectConstructParam *construct_params)
+{
+  GObject *object;
+
+  object = G_OBJECT_CLASS (ppd_action_panel_dim_parent_class)->constructor (type,
+                                                                            n_construct_params,
+                                                                            construct_params);
+  g_object_set (object,
+                "action-name", "panel_dim",
+                "action-description", "Panel dimmed on battery and in power-saver",
+                NULL);
+
+  return object;
+}
+
+static gboolean
+panel_connected (GUdevDevice *device)
+{
+  const char *value;
+  g_autofree gchar *stripped = NULL;
+
+  value = g_udev_device_get_sysfs_attr_uncached (device, PANEL_STATUS_SYSFS_NAME);
+  if (!value)
+    return FALSE;
+  stripped = g_strchomp (g_strdup (value));
+
+  return g_strcmp0 (stripped, "connected") == 0;
+}
+
+/* The connector's panel_power_savings, in its driver's group but amdgpu's */
+static char *
+find_panel_power_attr (GUdevDevice *device)
+{
+  g_autoptr(GDir) dir = NULL;
+  const char *name;
+
+  if (g_strcmp0 (g_udev_device_get_devtype (device), "drm_connector") != 0)
+    return NULL;
+
+  dir = g_dir_open (g_udev_device_get_sysfs_path (device), 0, NULL);
+  if (dir == NULL)
+    return NULL;
+
+  while ((name = g_dir_read_name (dir)) != NULL) {
+    g_autofree char *attr = NULL;
+
+    if (g_str_equal (name, AMDGPU_GROUP_NAME))
+      continue;
+    attr = g_build_filename (name, PANEL_POWER_SYSFS_NAME, NULL);
+    if (g_udev_device_has_sysfs_attr_uncached (device, attr))
+      return g_steal_pointer (&attr);
+  }
+
+  return NULL;
+}
+
+static gboolean
+write_panel_dim (GUdevDevice  *device,
+                 gint          target,
+                 GError      **error)
+{
+  g_autofree char *attr = NULL;
+  const char *value;
+
+  if (!panel_connected (device))
+    return TRUE;
+
+  attr = find_panel_power_attr (device);
+  if (attr == NULL)
+    return TRUE;
+
+  value = g_udev_device_get_sysfs_attr_uncached (device, attr);
+  if (value != NULL && g_ascii_strtoll (value, NULL, 10) == target)
+    return TRUE;
+
+  g_debug ("Writing %d to %s/%s", target, g_udev_device_get_sysfs_path (device), attr);
+  return ppd_utils_write_sysfs_int (device, attr, target, error);
+}
+
+static gboolean
+write_panel_dims (PpdActionPanelDim  *self,
+                  gint                target,
+                  GError            **error)
+{
+  g_autolist (GUdevDevice) devices = NULL;
+
+  devices = g_udev_client_query_by_subsystem (self->client, "drm");
+  for (GList *l = devices; l != NULL; l = l->next) {
+    if (!write_panel_dim (l->data, target, error))
+      return FALSE;
+  }
+
+  return TRUE;
+}
+
+static gboolean
+ppd_action_panel_dim_update_target (PpdActionPanelDim  *self,
+                                    GError            **error)
+{
+  self->target = self->on_battery || self->last_profile == PPD_PROFILE_POWER_SAVER;
+  g_info ("Panel dim %d (on battery %d, profile %s)", self->target, self->on_battery,
+          ppd_profile_to_str (self->last_profile));
+
+  return write_panel_dims (self, self->target, error);
+}
+
+static gboolean
+ppd_action_panel_dim_activate_profile (PpdAction   *action,
+                                       PpdProfile   profile,
+                                       GError     **error)
+{
+  PpdActionPanelDim *self = PPD_ACTION_PANEL_DIM (action);
+
+  self->last_profile = profile;
+
+  return ppd_action_panel_dim_update_target (self, error);
+}
+
+static gboolean
+ppd_action_panel_dim_power_changed (PpdAction             *action,
+                                    PpdPowerChangedReason  reason,
+                                    GError               **error)
+{
+  PpdActionPanelDim *self = PPD_ACTION_PANEL_DIM (action);
+
+  /* an unknown source dims only in power-saver */
+  self->on_battery = reason == PPD_POWER_CHANGED_REASON_BATTERY;
+
+  return ppd_action_panel_dim_update_target (self, error);
+}
+
+static void
+udev_uevent_cb (GUdevClient *client,
+                gchar       *action,
+                GUdevDevice *device,
+                gpointer     user_data)
+{
+  PpdActionPanelDim *self = user_data;
+
+  if (!g_str_equal (action, "add"))
+    return;
+
+  write_panel_dim (device, self->target, NULL);
+}
+
+static PpdProbeResult
+ppd_action_panel_dim_probe (PpdAction *action)
+{
+  PpdActionPanelDim *self = PPD_ACTION_PANEL_DIM (action);
+  g_autolist (GUdevDevice) devices = NULL;
+
+  devices = g_udev_client_query_by_subsystem (self->client, "drm");
+  for (GList *l = devices; l != NULL; l = l->next) {
+    g_autofree char *attr = find_panel_power_attr (l->data);
+
+    if (attr != NULL) {
+      g_debug ("Found %s on %s", attr, g_udev_device_get_sysfs_path (l->data));
+      return PPD_PROBE_RESULT_SUCCESS;
+    }
+  }
+
+  return PPD_PROBE_RESULT_FAIL;
+}
+
+static void
+ppd_action_panel_dim_finalize (GObject *object)
+{
+  PpdActionPanelDim *action;
+
+  action = PPD_ACTION_PANEL_DIM (object);
+  /* disabled, or the daemon stopping: the panel back at its brightness */
+  if (action->target != 0)
+    write_panel_dims (action, 0, NULL);
+  g_clear_object (&action->client);
+  G_OBJECT_CLASS (ppd_action_panel_dim_parent_class)->finalize (object);
+}
+
+static void
+ppd_action_panel_dim_class_init (PpdActionPanelDimClass *klass)
+{
+  GObjectClass *object_class;
+  PpdActionClass *driver_class;
+
+  object_class = G_OBJECT_CLASS (klass);
+  object_class->constructor = ppd_action_panel_dim_constructor;
+  object_class->finalize = ppd_action_panel_dim_finalize;
+
+  driver_class = PPD_ACTION_CLASS (klass);
+  driver_class->probe = ppd_action_panel_dim_probe;
+  driver_class->activate_profile = ppd_action_panel_dim_activate_profile;
+  driver_class->power_changed = ppd_action_panel_dim_power_changed;
+}
+
+static void
+ppd_action_panel_dim_init (PpdActionPanelDim *self)
+{
+  const gchar * const subsystem[] = { "drm", NULL };
+
+  self->client = g_udev_client_new (subsystem);
+  g_signal_connect_object (G_OBJECT (self->client), "uevent",
+                           G_CALLBACK (udev_uevent_cb), self, 0);
+}
