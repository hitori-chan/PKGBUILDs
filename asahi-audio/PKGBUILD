pkgname=asahi-audio
_commit=ab1b46928d056bb02bb4ad72d522dab57dc9efe1
pkgver=5.0.r2.g${_commit::8}
pkgrel=3
pkgdesc='Linux Userspace Audio Configuration'
arch=('aarch64')
url='http://asahilinux.org'
license=('GPL-2.0-or-later')
makedepends=(wireplumber pipewire make)
depends=('wireplumber>=0.5.2' 'pipewire>=1.0' 'bankstown>=1.1.0' 'lsp-plugins-lv2>=1.2.15' speakersafetyd 'triforce-lv2>=0.2.0')
source=(
  "${pkgname}-${_commit}.tar.gz::https://github.com/AsahiLinux/${pkgname}/archive/${_commit}.tar.gz"
  tweeter-delay.patch
)
sha256sums=('SKIP'
            'ff0349fff55bd4ccf718312452b9d1b9523155438b26fc41a1ff58fa506c8d96')

build() {
  cd "${srcdir}/${pkgname}-${_commit}"
  make
  # j504 and j514 (the 14-inch M3 Pro and Max) share one graph: the speaker filter runs on when its input stops
  sed -i -e 's/^\(\s*\)"node.passive": "true",/\1"node.passive": "true",\n\1"node.pause-on-idle": "false",/' \
    -e 's/^\(\s*\)"priority.session": 850,/\1"priority.session": 850,\n\1"node.pause-on-idle": "false",/' \
    firs/j314/graph-j504.json firs/j314/graph-j514.json
  # The woofers' two compressors look 5 ms ahead each, the tweeters nothing: delay the tweeters 10 ms to match
  patch -Np1 -i "${srcdir}/tweeter-delay.patch"
}

package() {
  cd "${srcdir}/${pkgname}-${_commit}"
  make DESTDIR="${pkgdir}" install
}
