# Maintainer: hitori-chan <hitori1403@gmail.com>

pkgbase=libane
pkgname=('libane' 'python-ane' 'onnxruntime-ep-ane')
pkgver=0.1.0
pkgrel=1
epoch=1
pkgdesc='The Apple Neural Engine on Linux, over the apple-ane accel driver'
arch=('aarch64')
url='https://github.com/hitori-chan/libane'
license=('LGPL-2.1-or-later')
makedepends=('linux-api-headers' 'onnxruntime-cpu' 'python')
checkdepends=('python-numpy')
source=("$pkgbase-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('67db5b8093799ef6de54356c5c995c60851ed33a791c5541af604eb919f864ca')

build() {
  make -C "$pkgbase-$pkgver" PREFIX=/usr
  make -C "$pkgbase-$pkgver" PREFIX=/usr ORT_INC=/usr/include/onnxruntime ort
}

check() {
  make -C "$pkgbase-$pkgver" PREFIX=/usr check
}

package_libane() {
  pkgdesc='The Apple Neural Engine on Linux: a C library over the apple-ane accel driver'
  depends=('glibc')
  make -C "$pkgbase-$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 "$pkgbase-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_python-ane() {
  pkgdesc='The Apple Neural Engine on Linux: the numpy wrapper over libane'
  depends=('libane' 'python' 'python-numpy')
  local site
  site=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
  install -Dm644 "$pkgbase-$pkgver/python/ane.py" "$pkgdir$site/ane.py"
  python3 -m compileall -q -o 0 -o 1 -s "$pkgdir" -p / "$pkgdir$site/ane.py"
}

package_onnxruntime-ep-ane() {
  pkgdesc='The Apple Neural Engine on Linux: an ONNX Runtime plugin execution provider over libane'
  depends=('glibc')
  optdepends=('python-onnxruntime: to run it from Python'
              'python-onnx: ane-epctx, which writes a model that runs a program')
  make -C "$pkgbase-$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install-ort
  install -Dm755 "$pkgbase-$pkgver/ort/ane-epctx.py" "$pkgdir/usr/bin/ane-epctx"
}
