# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Nikolay Rysev <mad.f3ka@gmail.com>

pkgname=fprintd
_commit=1905007d1cd5f9532987bb3e92010e6bfc5ccc36
_srcname=fprintd-$_commit
pkgver=1.94.5.r8.g${_commit::8}
pkgrel=1
pkgdesc="D-Bus service to access fingerprint readers"
url="https://github.com/hitori-chan/fprintd"
arch=(aarch64)
license=("GPL-2.0-or-later")
depends=(
  dbus
  glib2
  glibc
  libgcc
  "libfprint>=1.94.101"
  pam
  polkit
  systemd
  systemd-libs
)
makedepends=(
  glib2-devel
  gtk-doc
  meson
  pam_wrapper
  python-cairo
  python-dbus
  python-dbusmock
  python-packaging
)
groups=(fprint)
source=("$_srcname.tar.gz::https://github.com/hitori-chan/fprintd/archive/$_commit.tar.gz")
sha256sums=('38f509620e6c4ced4e0092b4806003521cbc4491f3dc31dab2a106a945edb6fb')

build() {
  local meson_options=(
    -D gtk_doc=true
    -D pam_modules_dir=/usr/lib/security
  )

  arch-meson $_srcname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  depends+=(libfprint-2.so)

  meson install -C build --destdir "$pkgdir"
}

