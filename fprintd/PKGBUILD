# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Nikolay Rysev <mad.f3ka@gmail.com>

pkgname=fprintd
_tree=fprintd
_commit=9bad064ca018ce3b2c9e0eebb069415a7017e0eb
_srcname=fprintd-$_commit
pkgver=1.94.5.r13.g${_commit::8}
pkgrel=1
pkgdesc="D-Bus service to access fingerprint readers"
url="https://github.com/hitori-chan/fprintd"
arch=(aarch64)
license=("GPL-2.0-or-later")
depends=(
  dbus
  glib2
  glibc
  libgcc
  "libfprint>=1.94.101"
  pam
  polkit
  systemd
  systemd-libs
)
makedepends=(
  glib2-devel
  gtk-doc
  meson
  pam_wrapper
  python-cairo
  python-dbus
  python-dbusmock
  python-packaging
)
groups=(fprint)
source=("$_srcname.tar.gz::https://github.com/hitori-chan/fprintd/archive/$_commit.tar.gz")
sha256sums=('c6c0b84bc9a1b9a1df34e790e6b2b67cf96a3a01f09076b09be0a9753ca031a0')

build() {
  local meson_options=(
    -D gtk_doc=true
    -D pam_modules_dir=/usr/lib/security
  )

  arch-meson $_srcname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  depends+=(libfprint-2.so)

  meson install -C build --destdir "$pkgdir"
}

