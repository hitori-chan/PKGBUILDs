+// The overlay goes in the request only when its buffer is committed, or at a modeset: left out, the kernel keeps it as
+// it is (appledrm swaps the planes in the request alone), so a primary-only flip under it changes nothing above.
+void Aquamarine::CDRMAtomicRequest::addConnectorOverlay(Hyprutils::Memory::CSharedPointer<SDRMConnector> connector, SDRMConnectorCommitData& data) {
+    const auto& OVERLAY = connector->crtc->overlay;
+    if (!OVERLAY)
+        return;
+
+    const bool enable = data.enabled && data.mainFB;
+    if (enable && !(data.committed & COutputState::AQ_OUTPUT_STATE_OVERLAY_BUFFER) && !data.modeset)
+        return;
+
+    if (!enable || !data.overlayFB) {
+        planeProps(OVERLAY, nullptr, 0, {});
+        return;
+    }
+
+    planeProps(OVERLAY, data.overlayFB, connector->crtc->id, {});
+    if (connector->output->supportsExplicit && data.outputState.overlayInFence >= 0 && OVERLAY->props.values.in_fence_fd)
+        add(OVERLAY->id, OVERLAY->props.values.in_fence_fd, data.outputState.overlayInFence);
+}
