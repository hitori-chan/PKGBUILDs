# Contributor: Tom Gundersen <teg@jklm.no>
# Contributor: Thomas Baechler <thomas@archlinux.org>

pkgname=libfprint
_commit=2ae2c23573505d8daabffaf15ea84349235f813d
_srcname=libfprint-$_commit
pkgver=1.94.100.r4.g${_commit::8}
pkgrel=1
pkgdesc="Library for fingerprint readers"
url="https://github.com/hitori-chan/libfprint"
arch=(aarch64)
license=("LGPL-2.1-or-later AND GPL-2.0-only WITH Linux-syscall-note")
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=(libfprint-2.so)
groups=(fprint)
source=("$_srcname.tar.gz::https://github.com/hitori-chan/libfprint/archive/$_commit.tar.gz")
sha256sums=('b60f907bd52adec4c6ae4fea756b7612b416b8ce46359a2f033c531e2185343b')

build() {
  local meson_options=(
    # Add virtual drivers for integration tests (e.g. in fprintd)
    -D drivers=all

    -D installed-tests=false
  )

  arch-meson $_srcname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

