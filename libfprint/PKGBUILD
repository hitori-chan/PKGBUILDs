# Contributor: Tom Gundersen <teg@jklm.no>
# Contributor: Thomas Baechler <thomas@archlinux.org>

pkgname=libfprint
_commit=c7dde5822e97abda36b61a172556ac8708c1a66a
_srcname=libfprint-$_commit
pkgver=1.94.100.r5.g${_commit::8}
pkgrel=1
pkgdesc="Library for fingerprint readers"
url="https://github.com/hitori-chan/libfprint"
arch=(aarch64)
license=("LGPL-2.1-or-later AND GPL-2.0-only WITH Linux-syscall-note")
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=(libfprint-2.so)
groups=(fprint)
source=("$_srcname.tar.gz::https://github.com/hitori-chan/libfprint/archive/$_commit.tar.gz")
sha256sums=('d731a0cd59db8efd9606c76b665bee24f893921e0f83c3679c33bc244619eb30')

build() {
  local meson_options=(
    # Add virtual drivers for integration tests (e.g. in fprintd)
    -D drivers=all

    -D installed-tests=false
  )

  arch-meson $_srcname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

