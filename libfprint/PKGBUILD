# Contributor: Tom Gundersen <teg@jklm.no>
# Contributor: Thomas Baechler <thomas@archlinux.org>

pkgname=libfprint
_commit=9f3abdad58206f83be2751c997aa40d631748884
_srcname=libfprint-$_commit
pkgver=1.94.101.r8.g${_commit::8}
pkgrel=1
pkgdesc="Library for fingerprint readers"
url="https://github.com/hitori-chan/libfprint"
arch=(aarch64)
license=("LGPL-2.1-or-later AND GPL-2.0-only WITH Linux-syscall-note")
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=(libfprint-2.so)
groups=(fprint)
source=("$_srcname.tar.gz::https://github.com/hitori-chan/libfprint/archive/$_commit.tar.gz")
sha256sums=('25ab779a5b34fe1ed1a9836d95c0d1643fc66a9a1a43c57c6b7ab283c2d4fa9b')

build() {
  local meson_options=(
    # Add virtual drivers for integration tests (e.g. in fprintd)
    -D drivers=all

    -D installed-tests=false
  )

  arch-meson $_srcname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  # all but egis_etu905: its identify cancel discards a USB transfer right after submitting it, and umockdev 0.19.9's
  # replay, when it reaps the discard first ("without corresponding submit"), stalls and times out: under the
  # suite's parallel load in most builds
  local tests=($(meson test -C build --list | sed -n 's/^.* - //p' | grep -vx 'libfprint:egis_etu905'))
  meson test -C build --print-errorlogs "${tests[@]}"
}

package() {
  meson install -C build --destdir "$pkgdir"
}

