+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: LinuxSyscalls|VMA
+desc: A guest's 4K pages on a host with larger pages
+$end_info$
+*/
+
+#include "LinuxSyscalls/Syscalls.h"
+#include "LinuxSyscalls/SyscallsVMATracking.h"
+
+#include <FEXCore/Utils/LogManager.h>
+#include <FEXCore/Utils/MathUtils.h>
+#include <FEXCore/Utils/TypeDefines.h>
+#include <FEXCore/fextl/vector.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <linux/mman.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// The guest sees 4K pages. A host page holds several, each with its guest's mapping and protection in VMATracking;
+// the host page gets the union of its guest pages' protections. What a host cannot express is given up:
+// a guest page that should fault beside one that should not does not fault.
+// A file offset not on a host page, or a part of a host page, is read rather than mapped.
+namespace FEX::HLE {
+
+namespace {
+const uint64_t HostPageSize = []() -> uint64_t {
+  const auto Size = sysconf(_SC_PAGESIZE);
+  return Size > 0 ? Size : FEXCore::Utils::FEX_PAGE_SIZE;
+}();
+
+uint64_t HostDown(uint64_t Value) {
+  return FEXCore::AlignDown(Value, HostPageSize);
+}
+
+uint64_t HostUp(uint64_t Value) {
+  return FEXCore::AlignUp(Value, HostPageSize);
+}
+
+// Fills [Start, Start + Size) from the file, zero past its end. A failed read leaves zeroes, as an unbacked page reads.
+void ReadFile(int FD, uint64_t Start, uint64_t Size, off_t Offset) {
+  auto* Dest = reinterpret_cast<std::byte*>(Start);
+  uint64_t Done = 0;
+  while (Done < Size) {
+    const auto Read = ::pread(FD, Dest + Done, Size - Done, Offset + Done);
+    if (Read == -1 && errno == EINTR) {
+      continue;
+    }
+    if (Read <= 0) {
+      memset(Dest + Done, 0, Size - Done);
+      return;
+    }
+    Done += Read;
+  }
+}
+} // namespace
+
+bool SyscallHandler::HostPagesLarger() {
+  return HostPageSize > FEXCore::Utils::FEX_PAGE_SIZE;
+}
+
+uint64_t SyscallHandler::HostPageDown(uint64_t Value) {
+  return HostDown(Value);
+}
+
+uint64_t SyscallHandler::HostPageUp(uint64_t Value) {
+  return HostUp(Value);
+}
+
+int SyscallHandler::HostProtOf(uint64_t HostPage) {
+  const auto End = HostPage + HostPageSize;
+  auto Mapping = VMATracking.VMAs.lower_bound(HostPage);
+  if (Mapping != VMATracking.VMAs.begin()) {
+    Mapping--;
+    if (Mapping->first + Mapping->second.Length <= HostPage) {
+      Mapping++;
+    }
+  }
+
+  int Prot = -1;
+  for (; Mapping != VMATracking.VMAs.end() && Mapping->first < End; Mapping++) {
+    Prot = std::max(Prot, 0);
+    Prot |= Mapping->second.Prot.Readable ? PROT_READ : 0;
+    Prot |= Mapping->second.Prot.Writable ? PROT_WRITE : 0;
+    Prot |= Mapping->second.Prot.Executable ? PROT_EXEC : 0;
+  }
+  return Prot;
+}
+
+bool SyscallHandler::HostHasGuest(uint64_t Start, uint64_t End) {
+  if (Start >= End) {
+    return false;
+  }
+  auto Mapping = VMATracking.VMAs.lower_bound(End);
+  if (Mapping == VMATracking.VMAs.begin()) {
+    return false;
+  }
+  Mapping--;
+  return Mapping->first + Mapping->second.Length > Start;
+}
+
+bool SyscallHandler::HostCovered(uint64_t Start, uint64_t End) {
+  auto Mapping = VMATracking.VMAs.upper_bound(Start);
+  if (Mapping != VMATracking.VMAs.begin()) {
+    Mapping--;
+  }
+  while (Start < End) {
+    if (Mapping == VMATracking.VMAs.end() || Mapping->first > Start) {
+      return false;
+    }
+    Start = std::max(Start, Mapping->first + Mapping->second.Length);
+    Mapping++;
+  }
+  return true;
+}
+
+void SyscallHandler::HostSyncEdges(uint64_t Base, uint64_t Size, bool UnmapEmpty) {
+  const uint64_t Edges[] = {HostDown(Base), HostDown(Base + Size - 1)};
+  const bool Partial[] = {(Base & (HostPageSize - 1)) != 0 || Size < HostPageSize, ((Base + Size) & (HostPageSize - 1)) != 0};
+
+  for (size_t i = 0; i < std::size(Edges); i++) {
+    if (!Partial[i] || (i == 1 && Edges[1] == Edges[0] && Partial[0])) {
+      continue;
+    }
+
+    const int Prot = HostProtOf(Edges[i]);
+    if (Prot >= 0) {
+      ::mprotect(reinterpret_cast<void*>(Edges[i]), HostPageSize, Prot);
+    } else if (UnmapEmpty) {
+      ::munmap(reinterpret_cast<void*>(Edges[i]), HostPageSize);
+    }
+  }
+}
+
+uint64_t SyscallHandler::HostMapPart(uint64_t Start, uint64_t End, int Flags, int FD, off_t Offset) {
+  const auto HostPage = HostDown(Start);
+
+  // A page none of the guest's: map it. MAP_FIXED replaces whatever is there, as on a 4K host.
+  if (HostProtOf(HostPage) < 0) {
+    const int PageFlags = ((Flags & MAP_FIXED_NOREPLACE) ? MAP_FIXED_NOREPLACE : MAP_FIXED) | MAP_PRIVATE | MAP_ANONYMOUS;
+    auto Mapped = ::mmap(reinterpret_cast<void*>(HostPage), HostPageSize, PROT_READ | PROT_WRITE, PageFlags, -1, 0);
+    if (Mapped == MAP_FAILED) {
+      return -errno;
+    }
+  } else if (::mprotect(reinterpret_cast<void*>(HostPage), HostPageSize, PROT_READ | PROT_WRITE) == -1) {
+    return -errno;
+  }
+
+  if (Flags & MAP_ANONYMOUS) {
+    memset(reinterpret_cast<void*>(Start), 0, End - Start);
+  } else {
+    ReadFile(FD, Start, End - Start, Offset);
+  }
+  return 0;
+}
+
+uint64_t SyscallHandler::HostMapWhole(uint64_t Start, uint64_t End, int Prot, int Flags, int FD, off_t Offset) {
+  const bool Anonymous = Flags & MAP_ANONYMOUS;
+  void* Mapped;
+  if (Anonymous) {
+    Mapped = ::mmap(reinterpret_cast<void*>(Start), End - Start, Prot, Flags, FD, 0);
+    return Mapped == MAP_FAILED ? -errno : reinterpret_cast<uint64_t>(Mapped);
+  }
+
+  if (!(Offset & (HostPageSize - 1))) {
+    // A loader maps a library's whole span from the file, then overlays it. A private page wholly past the file's end
+    // would raise SIGBUS when the overlay of a part of it writes there: anonymous from there.
+    uint64_t Direct = End - Start;
+    struct stat64 Stat;
+    if (!(Flags & MAP_SHARED) && fstat64(FD, &Stat) == 0 && S_ISREG(Stat.st_mode)) {
+      Direct = std::min(Direct, HostUp(Stat.st_size > Offset ? Stat.st_size - Offset : 0));
+    }
+
+    if (Direct == End - Start) {
+      Mapped = ::mmap(reinterpret_cast<void*>(Start), End - Start, Prot, Flags, FD, Offset);
+      return Mapped == MAP_FAILED ? -errno : reinterpret_cast<uint64_t>(Mapped);
+    }
+
+    const int AnonFlags = (Flags & (MAP_FIXED | MAP_FIXED_NOREPLACE)) | MAP_PRIVATE | MAP_ANONYMOUS;
+    Mapped = ::mmap(reinterpret_cast<void*>(Start), End - Start, Prot, AnonFlags, -1, 0);
+    if (Mapped == MAP_FAILED) {
+      return -errno;
+    }
+    if (Direct && ::mmap(Mapped, Direct, Prot, (Flags & ~MAP_FIXED_NOREPLACE) | MAP_FIXED, FD, Offset) == MAP_FAILED) {
+      const int Error = errno;
+      ::munmap(Mapped, End - Start);
+      return -Error;
+    }
+    return reinterpret_cast<uint64_t>(Mapped);
+  }
+
+  // The file's offset is not on a host page: a private copy.
+  const int AnonFlags = (Flags & (MAP_FIXED | MAP_FIXED_NOREPLACE)) | MAP_PRIVATE | MAP_ANONYMOUS;
+  Mapped = ::mmap(reinterpret_cast<void*>(Start), End - Start, PROT_READ | PROT_WRITE, AnonFlags, -1, 0);
+  if (Mapped == MAP_FAILED) {
+    return -errno;
+  }
+  ReadFile(FD, reinterpret_cast<uint64_t>(Mapped), End - Start, Offset);
+  if (!(Prot & PROT_WRITE) || (Prot & PROT_EXEC)) {
+    ::mprotect(Mapped, End - Start, Prot);
+  }
+  return reinterpret_cast<uint64_t>(Mapped);
+}
+
+uint64_t SyscallHandler::HostMmap(uint64_t Addr, size_t Length, int Prot, int Flags, int FD, off_t Offset) {
+  const auto Size = FEXCore::AlignUp(Length, FEXCore::Utils::FEX_PAGE_SIZE);
+  if (!Length || (Offset & (FEXCore::Utils::FEX_PAGE_SIZE - 1))) {
+    return -EINVAL;
+  }
+  if (Size < Length || HostUp(Size) < Size) {
+    return -ENOMEM;
+  }
+
+  if (!(Flags & (MAP_FIXED | MAP_FIXED_NOREPLACE))) {
+    return HostMapWhole(HostDown(Addr), HostDown(Addr) + HostUp(Size), Prot, Flags, FD, Offset);
+  }
+
+  if (Addr & (FEXCore::Utils::FEX_PAGE_SIZE - 1)) {
+    return -EINVAL;
+  }
+
+  const auto End = Addr + Size;
+  if (End < Addr || End > (1ULL << 47)) {
+    return -ENOMEM;
+  }
+  if (Flags & MAP_FIXED_NOREPLACE) {
+    auto Mapping = VMATracking.VMAs.lower_bound(End);
+    if (Mapping != VMATracking.VMAs.begin()) {
+      Mapping--;
+      if (Mapping->first + Mapping->second.Length > Addr) {
+        return -EEXIST;
+      }
+    }
+  }
+
+  // An edge with nothing of the guest's beside it is a whole page: mapped, not copied, so a shared one stays shared.
+  auto WholeStart = HostUp(Addr);
+  auto WholeEnd = HostDown(End);
+  if (!HostHasGuest(HostDown(Addr), Addr) && (Flags & MAP_ANONYMOUS || static_cast<uint64_t>(Offset) >= Addr - HostDown(Addr)) &&
+      !HostHasGuest(Addr, std::min(WholeStart, End))) {
+    WholeStart = HostDown(Addr);
+  }
+  if (End != WholeEnd && !HostHasGuest(End, HostUp(End)) && !HostHasGuest(std::max(WholeEnd, Addr), End)) {
+    WholeEnd = HostUp(End);
+  }
+
+  if (WholeStart >= WholeEnd) {
+    // Within one host page, or two without a whole one between.
+    const auto Middle = std::min(WholeStart, End);
+    auto Result = HostMapPart(Addr, Middle, Flags, FD, Offset);
+    if (FEX::HLE::HasSyscallError(Result)) {
+      return Result;
+    }
+    if (Middle < End) {
+      Result = HostMapPart(Middle, End, Flags, FD, Offset + (Middle - Addr));
+      if (FEX::HLE::HasSyscallError(Result)) {
+        return Result;
+      }
+    }
+    return Addr;
+  }
+
+  if (Addr < WholeStart) {
+    const auto Result = HostMapPart(Addr, WholeStart, Flags, FD, Offset);
+    if (FEX::HLE::HasSyscallError(Result)) {
+      return Result;
+    }
+  }
+
+  const off_t WholeOffset = Offset + (static_cast<int64_t>(WholeStart) - static_cast<int64_t>(Addr));
+  const auto Result = HostMapWhole(WholeStart, WholeEnd, Prot, Flags, FD, WholeOffset);
+  if (FEX::HLE::HasSyscallError(Result)) {
+    return Result;
+  }
+
+  if (WholeEnd < End) {
+    const auto Part = HostMapPart(WholeEnd, End, Flags, FD, Offset + (WholeEnd - Addr));
+    if (FEX::HLE::HasSyscallError(Part)) {
+      return Part;
+    }
+  }
+  return Addr;
+}
+
+// MAP_32BIT: x86-64's flag for the low 2 GiB, which arm64's kernel lacks.
+uint64_t SyscallHandler::HostMmapLow(size_t Length, int Prot, int Flags, int FD, off_t Offset) {
+  static constexpr uint64_t Bottom = 0x4000'0000ULL;
+  static constexpr uint64_t Top = 0x8000'0000ULL;
+  static uint64_t Next = Bottom;
+
+  const auto Size = HostUp(FEXCore::AlignUp(Length, FEXCore::Utils::FEX_PAGE_SIZE));
+  if (!Size || Size > Top - Bottom) {
+    return -ENOMEM;
+  }
+
+  for (uint64_t Tried = 0; Tried < Top - Bottom; Tried += HostPageSize) {
+    if (Next + Size > Top) {
+      Next = Bottom;
+    }
+    const auto Result = HostMmap(Next, Length, Prot, Flags | MAP_FIXED_NOREPLACE, FD, Offset);
+    if (!FEX::HLE::HasSyscallError(Result)) {
+      Next = Result + Size;
+      return Result;
+    }
+    if (Result != static_cast<uint64_t>(-EEXIST)) {
+      return Result;
+    }
+    Next += HostPageSize;
+  }
+  return -ENOMEM;
+}
+
+uint64_t SyscallHandler::HostMunmap(FEXCore::Core::InternalThreadState* Thread, uint64_t Addr, uint64_t Length) {
+  if (!Length || (Addr & (FEXCore::Utils::FEX_PAGE_SIZE - 1))) {
+    return -EINVAL;
+  }
+
+  const auto Size = FEXCore::AlignUp(Length, FEXCore::Utils::FEX_PAGE_SIZE);
+  if (Size < Length || Addr + Size < Addr || Addr + Size > (1ULL << 47)) {
+    return -EINVAL;
+  }
+  const auto WholeStart = HostUp(Addr);
+  const auto WholeEnd = HostDown(Addr + Size);
+  if (WholeStart < WholeEnd && ::munmap(reinterpret_cast<void*>(WholeStart), WholeEnd - WholeStart) == -1) {
+    return -errno;
+  }
+
+  TrackMunmap(Thread, reinterpret_cast<void*>(Addr), Length);
+  HostSyncEdges(Addr, Size, true);
+  return 0;
+}
+
+uint64_t SyscallHandler::HostMprotect(uint64_t Addr, uint64_t Length, int Prot) {
+  if (Addr & (FEXCore::Utils::FEX_PAGE_SIZE - 1)) {
+    return -EINVAL;
+  }
+  if (!Length) {
+    return 0;
+  }
+
+  const auto Size = FEXCore::AlignUp(Length, FEXCore::Utils::FEX_PAGE_SIZE);
+  if (Size < Length || Addr + Size < Addr || !HostCovered(Addr, Addr + Size)) {
+    return -ENOMEM;
+  }
+  const auto WholeStart = HostUp(Addr);
+  const auto WholeEnd = HostDown(Addr + Size);
+  if (WholeStart < WholeEnd && ::mprotect(reinterpret_cast<void*>(WholeStart), WholeEnd - WholeStart, Prot) == -1) {
+    return -errno;
+  }
+  return 0;
+}
+
+uint64_t SyscallHandler::HostMremap(uint64_t OldAddress, size_t OldSize, size_t NewSize, int Flags, uint64_t NewAddress) {
+  const auto Page = FEXCore::Utils::FEX_PAGE_SIZE;
+  if ((OldAddress & (Page - 1)) || !NewSize || FEXCore::AlignUp(NewSize, Page) < NewSize || FEXCore::AlignUp(OldSize, Page) < OldSize) {
+    return -EINVAL;
+  }
+  if (Flags & ~(MREMAP_MAYMOVE | MREMAP_FIXED | MREMAP_DONTUNMAP)) {
+    return -EINVAL;
+  }
+  const bool Fixed = Flags & MREMAP_FIXED;
+  if ((Fixed && !(Flags & MREMAP_MAYMOVE)) || (Fixed && (NewAddress & (Page - 1)))) {
+    return -EINVAL;
+  }
+
+  OldSize = FEXCore::AlignUp(OldSize, Page);
+  NewSize = FEXCore::AlignUp(NewSize, Page);
+  const auto OldEnd = OldAddress + OldSize;
+  if (!HostCovered(OldAddress, OldEnd)) {
+    return -EFAULT;
+  }
+
+  if (Fixed && NewAddress < OldEnd && OldAddress < NewAddress + NewSize) {
+    return -EINVAL;
+  }
+
+  if (!Fixed && !(Flags & MREMAP_DONTUNMAP)) {
+    // A shrink keeps its start. The caller's tracking drops the guest's tail; the host's whole pages go here.
+    if (NewSize <= OldSize) {
+      const auto FreeStart = HostUp(OldAddress + NewSize);
+      if (FreeStart < HostDown(OldEnd)) {
+        ::munmap(reinterpret_cast<void*>(FreeStart), HostDown(OldEnd) - FreeStart);
+      }
+      return OldAddress;
+    }
+
+    // Growth in place, if nothing of the guest's is in the way.
+    const auto NewEnd = OldAddress + NewSize;
+    if (!HostHasGuest(OldEnd, NewEnd)) {
+      if (HostUp(NewEnd) == HostUp(OldEnd)) {
+        return OldAddress;
+      }
+      if (!(OldEnd & (HostPageSize - 1)) || !HostHasGuest(OldEnd, HostUp(OldEnd))) {
+        const auto HostStart = HostUp(OldEnd);
+        auto Grown = ::mmap(reinterpret_cast<void*>(HostStart), HostUp(NewEnd) - HostStart, PROT_READ | PROT_WRITE,
+                            MAP_FIXED_NOREPLACE | MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        auto Mapping = VMATracking.FindVMAEntry(OldAddress);
+        const bool Plain = Mapping != VMATracking.VMAs.end() && !Mapping->second.Resource && !Mapping->second.Flags.Shared;
+        if (Grown != MAP_FAILED) {
+          if (Plain) {
+            int Prot = HostProtOf(HostDown(OldAddress));
+            ::mprotect(Grown, HostUp(NewEnd) - HostStart, std::max(Prot, 0));
+            return OldAddress;
+          }
+          ::munmap(Grown, HostUp(NewEnd) - HostStart);
+        }
+      }
+    }
+  }
+
+  if (!(Flags & MREMAP_MAYMOVE)) {
+    return -ENOMEM;
+  }
+
+  // A move of whole host pages is the kernel's, which keeps sharing and the pages themselves.
+  const bool WholeOld = !(OldAddress & (HostPageSize - 1)) && !HostHasGuest(OldEnd, HostUp(OldEnd));
+  if (WholeOld && (!Fixed || !(NewAddress & (HostPageSize - 1)))) {
+    auto Result = ::mremap(reinterpret_cast<void*>(OldAddress), HostUp(OldSize), HostUp(NewSize), Flags, reinterpret_cast<void*>(NewAddress));
+    return Result == MAP_FAILED ? -errno : reinterpret_cast<uint64_t>(Result);
+  }
+
+  // Parts of host pages: a new mapping and a copy.
+  const int MapFlags = MAP_PRIVATE | MAP_ANONYMOUS | (Fixed ? MAP_FIXED : 0);
+  auto Result = HostMmap(Fixed ? NewAddress : 0, NewSize, PROT_READ | PROT_WRITE, MapFlags, -1, 0);
+  if (FEX::HLE::HasSyscallError(Result)) {
+    return Result;
+  }
+  memcpy(reinterpret_cast<void*>(Result), reinterpret_cast<void*>(OldAddress), std::min(OldSize, NewSize));
+  if (HostUp(OldAddress) < HostDown(OldEnd) && !(Flags & MREMAP_DONTUNMAP)) {
+    ::munmap(reinterpret_cast<void*>(HostUp(OldAddress)), HostDown(OldEnd) - HostUp(OldAddress));
+  }
+  return Result;
+}
+
+uint64_t SyscallHandler::HostMadvise(uint64_t Addr, uint64_t Length, int Advice) {
+  if (Addr & (FEXCore::Utils::FEX_PAGE_SIZE - 1)) {
+    return -EINVAL;
+  }
+  if (!Length) {
+    return 0;
+  }
+
+  const auto Size = FEXCore::AlignUp(Length, FEXCore::Utils::FEX_PAGE_SIZE);
+  if (Size < Length || Addr + Size < Addr) {
+    return -EINVAL;
+  }
+  const auto End = Addr + Size;
+
+  // An edge whose host page holds nothing else of the guest's is the kernel's, with the mapping's own semantics.
+  auto WholeStart = HostUp(Addr);
+  auto WholeEnd = HostDown(End);
+  if (!HostHasGuest(HostDown(Addr), Addr) && (WholeStart <= End || !HostHasGuest(End, WholeStart))) {
+    WholeStart = HostDown(Addr);
+  }
+  if (WholeEnd != End && !HostHasGuest(End, HostUp(End))) {
+    WholeEnd = HostUp(End);
+  }
+
+  auto Clear = [this](uint64_t Start, uint64_t PartEnd) {
+    if (Start >= PartEnd) {
+      return;
+    }
+    // A part of a host page: only a private anonymous page reads as zero afterwards.
+    auto Mapping = VMATracking.FindVMAEntry(Start);
+    if (Mapping != VMATracking.VMAs.end() && !Mapping->second.Resource && !Mapping->second.Flags.Shared && Mapping->second.Prot.Writable) {
+      ::mprotect(reinterpret_cast<void*>(HostDown(Start)), HostPageSize, PROT_READ | PROT_WRITE);
+      memset(reinterpret_cast<void*>(Start), 0, PartEnd - Start);
+    }
+  };
+
+  if (WholeStart >= WholeEnd) {
+    if (Advice == MADV_DONTNEED) {
+      Clear(Addr, End);
+    }
+    return 0;
+  }
+
+  if (Advice == MADV_DONTNEED) {
+    Clear(Addr, std::min(WholeStart, End));
+    Clear(std::max(WholeEnd, Addr), End);
+  }
+  if (::madvise(reinterpret_cast<void*>(WholeStart), WholeEnd - WholeStart, Advice) == -1) {
+    return -errno;
+  }
+  return 0;
+}
+
+uint64_t SyscallHandler::HostMsync(uint64_t Addr, uint64_t Length, int Flags) {
+  if (Addr & (FEXCore::Utils::FEX_PAGE_SIZE - 1)) {
+    return -EINVAL;
+  }
+  const auto Size = FEXCore::AlignUp(Length, FEXCore::Utils::FEX_PAGE_SIZE);
+  if (Size < Length || Addr + Size < Addr || !HostCovered(Addr, Addr + Size)) {
+    return -ENOMEM;
+  }
+  if (!Size) {
+    return 0;
+  }
+  const auto Start = HostDown(Addr);
+  if (::msync(reinterpret_cast<void*>(Start), HostUp(Addr + Size) - Start, Flags) == -1) {
+    return -errno;
+  }
+  return 0;
+}
+
+uint64_t SyscallHandler::HostMincore(uint64_t Addr, uint64_t Length, uint8_t* Vec) {
+  const auto Page = FEXCore::Utils::FEX_PAGE_SIZE;
+  if (Addr & (Page - 1)) {
+    return -EINVAL;
+  }
+  const auto Size = FEXCore::AlignUp(Length, Page);
