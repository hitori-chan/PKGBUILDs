source=("git+https://github.com/FEX-Emu/FEX.git#commit=${_fex}"
        "cmake.patch"
        "p3s.patch"
        "Config.json"
        "fex-rootfs.hook"
        "fex-rootfs.service"
        "fex-rootfs.sh")
sha256sums=('SKIP'
            '3f66fc27d99b463ac2116d321ea626a9f0be5c3ddad544911b6db66545f8ddcc'
            'SKIP'
            'SKIP'
            'SKIP'
