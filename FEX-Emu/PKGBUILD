install=FEX-Emu.install

prepare() {
  cd "${srcdir}/FEX"
  # Needed because the repo has submodules
  git submodule update --init --recursive

  patch -p1 < ../../cmake.patch
  patch -p1 < ../../p3s.patch
  sed -i 's/^#define LG_PAGE .*/#define LG_PAGE 14/; s/^#define LG_HUGEPAGE .*/#define LG_HUGEPAGE 25/' \
    External/jemalloc_glibc/pregen/include/jemalloc/internal/jemalloc_internal_defs.h
  # For cherry-picking we need a git user with name and e-mail as committer
  # (do not use the --global flag!)
  git config user.name "John Doe"
  git config user.email "john.doe@example.com"
  #git cherry-pick <sha>
}

build() {
  cd ${srcdir}/FEX
  rm -rf build
  mkdir -p build || true
  cd build
  CC=clang CXX=clang++ cmake \
    -G Ninja \
    -DENABLE_OFFLINE_TELEMETRY=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DUSE_LINKER=lld \
    -DENABLE_LTO=ON \
    -DBUILD_TESTING=FALSE \
    -DENABLE_ASSERTIONS=OFF \
    -DTUNE_CPU=apple-m3 \
    -DTUNE_ARCH=armv8.6-a \
    ..
  ninja
  if objdump -d Bin/FEXInterpreter | grep cnth; then
      echo "::error file=fex-emu::Found illegal instruction 'cnth'"
      exit 1
  fi
}

package() {
  cd ${srcdir}/FEX/build
  DESTDIR="${pkgdir}" ninja install
  mkdir -p "${pkgdir}"/usr/share/fex-emu/RootFS
  mkdir -p "${pkgdir}"/usr/share/fex-emu/overlays
  cd "${srcdir}"
  install -Dm644 Config.json "${pkgdir}"/usr/share/fex-emu/Config.json
  install -Dm755 fex-rootfs.sh "${pkgdir}"/usr/lib/fex-emu/fex-rootfs.sh
  install -Dm644 fex-rootfs.service "${pkgdir}"/usr/lib/systemd/system/fex-rootfs.service
  install -Dm644 fex-rootfs.hook "${pkgdir}"/usr/share/libalpm/hooks/fex-rootfs.hook
  install -d "${pkgdir}"/usr/lib/systemd/system/multi-user.target.wants
  ln -s ../fex-rootfs.service "${pkgdir}"/usr/lib/systemd/system/multi-user.target.wants/fex-rootfs.service
}
